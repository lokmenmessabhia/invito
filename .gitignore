# Local environment / secrets
.env
.env.*
!.env.example
config/database.local.php

# Uploaded user content (never commit personal images)
/uploads/*
!/uploads/.gitkeep

# Database backups (never commit dumps)
/backup/*
!/backup/.htaccess

# Runtime and temporary files
*.log
*.sql.gz
*.tmp
*.bak
*.old
*.orig
*.save
*.swp
*.swo
.backup.lock

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml

# Local tooling state (keep project skills tracked)
.agents/
